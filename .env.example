# Copy this file to .env, then configure ONE provider/model pair.
# NEVER commit .env or real API keys.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Examples (uncomment BOTH lines for one alternative provider):
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
CLAUDE_API_KEY=

APP_TIMEZONE=Asia/Dhaka
DATA_DIR=data

# Optional distance cutoff for semantic results; blank = no cutoff.
# Tune for your actual Chroma embedding/distance metric before enabling.
MAX_SEMANTIC_DISTANCE=
